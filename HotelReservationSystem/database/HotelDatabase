package HotelReservationSystem.database;

import HotelReservationSystem.model.*;

import java.util.ArrayList;
import java.time.LocalDate;
import java.util.List;

public class HotelDatabase {
    private List <Guest> guests;
    private List<Room> rooms;
    private List <Reservation> reservations;
    private List <Room> availableRooms;
    private List <Reservation> getReservedRooms;
    private List <RoomType> roomTypes;
    private List <Amenity> allAmenities;
    public List <Invoice> Invoices;
    // constructor
    public HotelDatabase(){
        guests = new ArrayList<>();
        rooms = new ArrayList<>();
        reservations = new ArrayList<>();
        availableRooms = new ArrayList<>();
        getReservedRooms = new ArrayList<>();
        roomTypes = new ArrayList<>();
        allAmenities = new ArrayList<>();
        Invoices = new ArrayList<>();
    }
    //Add guest
    public void addGuest(Guest g){

        guests.add(g);
    }
    //Check username
    public boolean doesUsernameExist(String username){
        for (Guest i : guests){
            if (i.getUsername().equals(username)) {
                return true;
            }
        }
        return false;
    }
    public boolean register(Guest g){
        if (doesUsernameExist(g.getUsername())){
            return false;
        }
        addGuest(g);
        return true;
    };
    public Guest login(String username, String password){
        for (Guest g:guests){
            if (g.getUsername().equals(username)){
                if (g.getPassword().equals(password)){
                    return g;
                }
            }
        }
        return null;
    };
    public Room viewAvailableRooms(){
        for (Room r:rooms){
            if (r.getAvailability()){
                availableRooms.add(r);
            }
        }
        return (Room)availableRooms;
    };
    public boolean makeReservation(Reservation r){
        if (r.getRoom().getAvailability()){
            reservations.add(r);
            r.setStatus(Reservation.Status.PENDING);
            r.getRoom().setRoomAvailability(false);
            return true;
        }
        return false;
    };
    public void cancelReservation(Reservation r){
        r.getRoom().setRoomAvailability(true);
        reservations.remove(r);
        r.setStatus(Reservation.Status.CANCELLED);
        System.out.println("Reservation cancelled successfully!");
    }
    public Reservation viewReservations(Guest g){
        for (Reservation r : reservations){
            if (r.getGuest().equals(g)){
                getReservedRooms.add(r);
            }
        }
        return (Reservation)getReservedRooms;
    }
    public void createInvoice(double total, List<HotelReservationSystem.enums.paymentMethod> paymentMethods, LocalDate paymentDate){
        Invoice i1 = new Invoice(total,paymentMethods,paymentDate);
        Invoices.add(i1);
    }
    public Guest viewAllGuests(){
        return (Guest)guests;
    }
    public Room viewAllRooms(){
        return (Room)rooms;
    }
    public Reservation viewAllReservations(){
        return (Reservation) reservations;
    }
    //admin CRUD
    //RoomType
    public void addRoomType(RoomType type){
        roomTypes.add(type);
    }
    public RoomType viewAllRoomTypes(){
        return (RoomType)roomTypes;
    }
    public void removeRoomType(RoomType type){
        roomTypes.remove(type);
    }
    //Room
    public void addRoom(Room room){
        rooms.add(room);
    }
    public void removeRoom(Room room){
        rooms.remove(room);
    }
    //Amenity
    public Amenity viewAllAmenities(){
        return (Amenity)allAmenities;
    }
    public void addAmenity(Amenity amenity){
        allAmenities.add(amenity);
    }
    public void removeAmenity(Amenity amenity){
        allAmenities.remove(amenity);
    }
    //receptionist management
    public void setCheckInDate(Reservation r,LocalDate checkInDate){
        r.setCheckIn(checkInDate);
    }
    public void setCheckOutDate(Reservation r, LocalDate checkOutDate){
        r.setCheckOut(checkOutDate);
    }
}
