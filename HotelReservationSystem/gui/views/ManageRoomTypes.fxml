<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="HotelReservationSystem.gui.controllers.ManageRoomTypesController"
            styleClass="main-background">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="Manage Room Types" styleClass="title-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back"
                    onAction="#goBack"
                    styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="25" right="35" bottom="25" left="35"/>
            </padding>

            <GridPane hgap="12" vgap="12" styleClass="card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Type Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="typeNameField"
                           promptText="Single / Double / Suite"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Max Capacity:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="capacityField"
                           promptText="2"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Base Price:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="priceField"
                           promptText="1500"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Add Room Type"
                        onAction="#addRoomType"
                        styleClass="main-button"/>

                <Button text="Update Selected"
                        onAction="#updateRoomType"
                        styleClass="main-button"/>

                <Button text="Delete Selected"
                        onAction="#deleteRoomType"
                        styleClass="secondary-button"/>

                <Button text="Clear Fields"
                        onAction="#clearFields"
                        styleClass="secondary-button"/>
            </HBox>

            <TableView fx:id="roomTypesTable" prefHeight="350">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Room Type" prefWidth="220"/>
                    <TableColumn fx:id="capacityColumn" text="Max Capacity" prefWidth="160"/>
                    <TableColumn fx:id="priceColumn" text="Base Price" prefWidth="160"/>
                </columns>
            </TableView>

            <Label fx:id="messageLabel"/>

        </VBox>
    </center>

</BorderPane>