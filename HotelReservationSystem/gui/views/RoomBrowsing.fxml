<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="HotelReservationSystem.gui.controllers.RoomBrowsingController"
            styleClass="main-background">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="Browse Available Rooms" styleClass="title-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back"
                    onAction="#goBack"
                    styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="25" right="35" bottom="25" left="35"/>
            </padding>

            <HBox spacing="12" alignment="CENTER" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <ComboBox fx:id="typeFilterCombo"
                          promptText="Room Type"
                          prefWidth="160"/>

                <TextField fx:id="maxPriceField"
                           promptText="Max Price"
                           prefWidth="130"/>

                <TextField fx:id="amenityField"
                           promptText="Amenity e.g. WiFi"
                           prefWidth="180"/>

                <Button text="Apply Filter"
                        onAction="#applyFilter"
                        styleClass="main-button"/>

                <Button text="Reset"
                        onAction="#resetFilter"
                        styleClass="secondary-button"/>
            </HBox>

            <TableView fx:id="roomTable" prefHeight="350">
                <columns>
                    <TableColumn fx:id="roomIdColumn" text="Room ID" prefWidth="90"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="floorColumn" text="Floor" prefWidth="90"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="120"/>
                    <TableColumn fx:id="amenitiesColumn" text="Amenities" prefWidth="300"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Make Reservation"
                        onAction="#goToMakeReservation"
                        styleClass="main-button"/>
            </HBox>

            <Label fx:id="messageLabel"/>

        </VBox>
    </center>

</BorderPane>