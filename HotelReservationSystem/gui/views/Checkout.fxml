<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="HotelReservationSystem.gui.controllers.CheckoutController"
            styleClass="main-background">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="Checkout / Payment" styleClass="title-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back"
                    onAction="#goBack"
                    styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="25" right="35" bottom="25" left="35"/>
            </padding>

            <Label fx:id="balanceLabel" styleClass="subtitle-label"/>

            <TableView fx:id="checkoutTable" prefHeight="320">
                <columns>
                    <TableColumn fx:id="roomIdColumn" text="Room ID" prefWidth="90"/>
                    <TableColumn fx:id="roomTypeColumn" text="Room Type" prefWidth="130"/>
                    <TableColumn fx:id="checkInColumn" text="Check-in" prefWidth="130"/>
                    <TableColumn fx:id="checkOutColumn" text="Check-out" prefWidth="130"/>
                    <TableColumn fx:id="nightsColumn" text="Nights" prefWidth="90"/>
                    <TableColumn fx:id="totalColumn" text="Total Price" prefWidth="130"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                </columns>
            </TableView>

            <GridPane hgap="15" vgap="15" maxWidth="550" styleClass="card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Selected Total:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="selectedTotalLabel" text="0 EGP" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Payment Method:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                <HBox spacing="15" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <CheckBox fx:id="cashCheckBox" text="Cash"/>
                    <CheckBox fx:id="creditCardCheckBox" text="Credit Card"/>
                    <CheckBox fx:id="onlineCheckBox" text="Online"/>
                </HBox>
            </GridPane>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Confirm Payment"
                        onAction="#confirmPayment"
                        styleClass="main-button"/>

                <Button text="Refresh"
                        onAction="#loadReservations"
                        styleClass="secondary-button"/>
            </HBox>

            <Label fx:id="messageLabel"/>

        </VBox>
    </center>

</BorderPane>