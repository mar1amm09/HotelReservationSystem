<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="HotelReservationSystem.gui.controllers.ReceptionistDashboardController"
            styleClass="main-background">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="Receptionist Dashboard" styleClass="title-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER">
            <padding>
                <Insets top="35" right="40" bottom="35" left="40"/>
            </padding>

            <Label fx:id="welcomeLabel" styleClass="subtitle-label"/>

            <GridPane hgap="20" vgap="20" alignment="CENTER">

                <Button text="View Reservations"
                        onAction="#viewReservations"
                        styleClass="main-button"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="0"/>

                <Button text="Check-in / Check-out"
                        onAction="#manageCheckInOut"
                        styleClass="main-button"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="1"/>

                <Button text="View Rooms"
                        onAction="#viewRooms"
                        styleClass="secondary-button"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="0"/>

            </GridPane>

            <Label fx:id="messageLabel"/>

        </VBox>
    </center>

</BorderPane>