<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="HotelReservationSystem.gui.controllers.AdminGuestsController"
            styleClass="main-background">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="All Guests" styleClass="title-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back"
                    onAction="#goBack"
                    styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="25" right="35" bottom="25" left="35"/>
            </padding>

            <TableView fx:id="guestsTable" prefHeight="420">
                <columns>
                    <TableColumn fx:id="usernameColumn" text="Username" prefWidth="150"/>
                    <TableColumn fx:id="dobColumn" text="Date of Birth" prefWidth="150"/>
                    <TableColumn fx:id="genderColumn" text="Gender" prefWidth="120"/>
                    <TableColumn fx:id="addressColumn" text="Address" prefWidth="220"/>
                    <TableColumn fx:id="balanceColumn" text="Balance" prefWidth="130"/>
                </columns>
            </TableView>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Refresh"
                        onAction="#loadGuests"
                        styleClass="main-button"/>
            </HBox>

            <Label fx:id="messageLabel"/>

        </VBox>
    </center>

</BorderPane>