<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="HotelReservationSystem.gui.controllers.AdminRoomsController"
            styleClass="main-background">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="All Rooms" styleClass="title-label"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back"
                    onAction="#goBack"
                    styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="25" right="35" bottom="25" left="35"/>
            </padding>

            <TableView fx:id="roomsTable" prefHeight="420">
                <columns>
                    <TableColumn fx:id="roomIdColumn" text="Room ID" prefWidth="90"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="130"/>
                    <TableColumn fx:id="floorColumn" text="Floor" prefWidth="90"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="120"/>
                    <TableColumn fx:id="amenitiesColumn" text="Amenities" prefWidth="330"/>
                    <TableColumn fx:id="availabilityColumn" text="Availability" prefWidth="130"/>
                </columns>
            </TableView>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Refresh"
                        onAction="#loadRooms"
                        styleClass="main-button"/>
            </HBox>

            <Label fx:id="messageLabel"/>

        </VBox>
    </center>

</BorderPane>