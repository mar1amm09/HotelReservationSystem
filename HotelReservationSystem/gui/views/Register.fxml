<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="HotelReservationSystem.gui.controllers.RegisterController"
            styleClass="main-background">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="12" alignment="CENTER" maxWidth="450">

                    <padding>
                        <Insets top="35" right="35" bottom="35" left="35"/>
                    </padding>

                    <Label text="Create Account" styleClass="title-label"/>

                    <ComboBox fx:id="accountTypeCombo"
                              promptText="Register as"
                              maxWidth="350"
                              onAction="#handleAccountTypeChange"/>

                    <TextField fx:id="usernameField"
                               promptText="Username"
                               maxWidth="350"
                               visible="false"
                               managed="false"/>

                    <PasswordField fx:id="passwordField"
                                   promptText="Password"
                                   maxWidth="350"
                                   visible="false"
                                   managed="false"/>

                    <Label fx:id="dobLabel"
                           text="Date of Birth"
                           visible="false"
                           managed="false"/>

                    <HBox fx:id="dobBox"
                          spacing="8"
                          alignment="CENTER"
                          visible="false"
                          managed="false">

                        <ComboBox fx:id="dayCombo"
                                  promptText="Day"
                                  prefWidth="90"/>

                        <ComboBox fx:id="monthCombo"
                                  promptText="Month"
                                  prefWidth="100"/>

                        <ComboBox fx:id="yearCombo"
                                  promptText="Year"
                                  prefWidth="110"/>

                    </HBox>

                    <!-- Guest fields -->

                    <Label fx:id="genderLabel"
                           text="Gender"
                           visible="false"
                           managed="false"/>

                    <ComboBox fx:id="genderCombo"
                              promptText="Gender"
                              maxWidth="350"
                              visible="false"
                              managed="false"/>

                    <TextField fx:id="addressField"
                               promptText="Address"
                               maxWidth="350"
                               visible="false"
                               managed="false"/>

                    <TextField fx:id="balanceField"
                               promptText="Balance"
                               maxWidth="350"
                               visible="false"
                               managed="false"/>



                    <!-- Staff fields -->

                    <TextField fx:id="workingHoursField"
                               promptText="Working hours"
                               maxWidth="350"
                               visible="false"
                               managed="false"/>

                    <PasswordField fx:id="staffCodeField"
                                   promptText="Staff secret code"
                                   maxWidth="350"
                                   visible="false"
                                   managed="false"/>

                    <Button fx:id="registerButton"
                            text="Register"
                            onAction="#handleRegister"
                            styleClass="main-button"
                            visible="false"
                            managed="false"/>

                    <Button text="Back"
                            onAction="#goBack"
                            styleClass="secondary-button"/>

                    <Label fx:id="messageLabel" textFill="red"/>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>